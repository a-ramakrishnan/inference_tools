{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": ".venv/bin/ibench",
      "runtimeArgs": [
        "serve",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "gateway",
      "runtimeExecutable": ".venv/bin/ibench",
      "runtimeArgs": [
        "gateway"
      ],
      "port": 8080
    }
  ]
}